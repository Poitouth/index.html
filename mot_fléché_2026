    letter-spacing: -0.01em;
    position: relative;
  }
  header p.kicker{
    margin: .6rem auto 0;
    max-width: 28rem;
    color: rgba(255,255,255,0.8);
    font-size: .95rem;
    position: relative;
  }

  /* ---------- Main ---------- */
  main{
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.1rem 3rem;
  }

  .intro{
    text-align: center;
    color: var(--ink-soft);
    font-size: 1rem;
    margin: 0 0 1.75rem;
    max-width: 34rem;
    margin-left: auto;
    margin-right: auto;
  }
  .intro strong{ color: var(--ink); }

  /* ---------- Fallback (no-JS) : contenu 100% statique ---------- */
  noscript .fallback{
    display: block;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.25rem 1.5rem;
