  .fallback h2{ font-size: 1rem; margin: 0 0 .75rem; }
  .fallback ol{ margin: 0; padding-left: 1.2rem; }
  .fallback li{ margin-bottom: .5rem; }
  .fallback details{ margin-top: 1rem; }
  .fallback summary{ cursor: pointer; font-weight: 700; color: var(--forest); }
  .fallback .answers{ margin-top: .6rem; color: var(--ink-soft); }
  .fallback .cta{ margin-top: 1rem; }

  /* ---------- Grid wrapper ---------- */
  .grid-wrapper{
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem;
    margin-bottom: 1.75rem;
  }
  .grid-scroll{
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    max-height: 62vh;
    padding-bottom: .35rem;
  }
  #grid{
    display: grid;
    gap: 2px;
    width: max-content;
    margin: 0 auto;
  }
  #grid:empty::before{
    content: "Chargement de la grille…";
    display: block;
    color: var(--ink-soft);
    font-size: .9rem;
    padding: 1rem;
  }
  .cell-wrap{
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
  }
  .cell-blocked{
    width: 1.75rem;
    height: 1.75rem;
  }
  .cell-number{
    position: absolute;
    top: 1px;
    left: 2px;
    font-size: .5rem;
    font-weight: 700;
    color: var(--ink-soft);
    line-height: 1;
    pointer-events: none;
    z-index: 1;
  }
  .cell-wrap input{
    width: 100%;
    height: 100%;
    text-align: center;
    text-transform: uppercase;
    font-size: .95rem;
    font-weight: 700;
    font-family: inherit;
    color: var(--ink);
    background: var(--paper-soft);
    border: 1.5px solid var(--line);
    border-radius: 3px;
    padding: 0;
    caret-color: var(--forest);
  }
  .cell-wrap input:focus{ background: #fff; border-color: var(--forest); }
  .cell-wrap.is-active-word input{ background: #EAF1F0; }
  .cell-wrap.is-revealed input{ background: var(--gold-soft); border-color: var(--gold); color: var(--gold-ink); }
  .cell-wrap.is-solved input{ border-color: var(--gold); }
  .cell-wrap.is-bonus input{ box-shadow: inset 0 0 0 1.5px var(--gold); }

  @media (min-width: 480px){
    .cell-wrap, .cell-blocked{ width: 2rem; height: 2rem; }
    .cell-wrap input{ font-size: 1.05rem; }
  }

  /* ---------- Clue lists ---------- */
  .clue-columns{
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 620px){
    .clue-columns{ grid-template-columns: 1fr 1fr; }
  }
  .clue-block h2{
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--ink-soft);
    margin: 0 0 .6rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }
  .clue-list{
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }
  .clue-item{
    display: block;
    width: 100%;
    text-align: left;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: .55rem .7rem;
    font-family: inherit;
    font-size: .85rem;
    color: var(--ink);
    cursor: pointer;
  }
  .clue-item:hover{ border-color: var(--blue-grey); }
  .clue-item.is-active{ border-color: var(--forest); background: #EAF1F0; }
  .clue-item.is-solved{ border-color: var(--gold); }
  .clue-item .num{ font-weight: 700; color: var(--forest); margin-right: .3rem; }
  .clue-item .count{ color: var(--ink-soft); font-size: .78rem; }
  .clue-item.is-bonus{ background: var(--gold-soft); border-color: var(--gold); }
  .clue-item.is-bonus .num{ color: var(--gold-ink); }

  /* ---------- Actions ---------- */
  .actions{ text-align: center; margin-bottom: 1rem; }
  #reveal-btn{
    appearance: none;
    border: none;
    background: var(--gold);
    color: var(--forest-deep);
    font-family: inherit;
    font-weight: 700;
    font-size: .95rem;
    padding: .8rem 1.6rem;
    border-radius: 999px;
