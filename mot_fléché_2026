  }
  #reveal-btn:hover{ background: #e6b41c; }
  .actions p{ margin: .75rem 0 0; font-size: .82rem; color: var(--ink-soft); }

  /* ---------- Bonus banner ---------- */
  #bonus-banner{
    display: none;
    background: var(--forest);
    color: #fff;
    border-radius: var(--radius);
    padding: 1.25rem 1.25rem 1.4rem;
    text-align: center;
    margin: 1.75rem 0;
  }
  #bonus-banner.is-visible{ display: block; }
  #bonus-banner p{
