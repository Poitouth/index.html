  </div>
</main>

<footer>
  <a href="https://www.ekodev.com" target="_blank" rel="noopener">ekodev.com →</a>
</footer>

<script>
(function () {
  "use strict";

  /* ------------------------------------------------------------
     CONFIG
  ------------------------------------------------------------ */
  var RDV_URL = "https://meetings-eu1.hubspot.com/hpoitout";

  /* ------------------------------------------------------------
     CONTENU DE LA GRILLE — à mettre à jour chaque année.
     Chaque entrée : { clue, answer, row, col, dir }
       - answer : MAJUSCULES, sans accent, sans espace
       - row/col : position de la PREMIÈRE lettre (0-indexé)
       - dir : "H" (vers la droite) ou "V" (vers le bas)

     ⚠️ Comme pour tout vrai mot fléché, les mots doivent s'entrecroiser sur
     de vraies lettres communes : changer un mot exige de recalculer ses
     coordonnées. Le plus sûr est de redemander une grille complète.
  ------------------------------------------------------------ */
  var WORDS = [
    { clue: "Partielle en France, totale en Espagne, elle a assombri le ciel ce 12 août 2026.", answer: "ECLIPSE", row: 0, col: 6, dir: "V" },
    { clue: "Là où se cache l'essentiel de votre Scope 3.", answer: "ACHATS", row: 1, col: 8, dir: "V" },
    { clue: "Le paquet européen qui a allégé la CSRD en 2026.", answer: "OMNIBUS", row: 2, col: 0, dir: "V" },
    { clue: "Ce que votre organisation doit apprendre à faire, encore et encore, face au climat.", answer: "ADAPTATION", row: 2, col: 10, dir: "V" },
    { clue: "Elle a battu tous les records en juillet 2026.", answer: "CANICULE", row: 3, col: 4, dir: "V" },
    { clue: "Le G de ESG.", answer: "GOUVERNANCE", row: 5, col: 2, dir: "V" },
    { clue: "Le grand enjeu qui arrive juste après le climat sur la liste des risques.", answer: "BIODIVERSITE", row: 6, col: 0, dir: "H" },
    { clue: "Ce que gagne une organisation qui anticipe plutôt que subit.", answer: "RESILIENCE", row: 6, col: 7, dir: "V" }
  ];

  /* ------------------------------------------------------------
     MOT MYSTÈRE — hors grille.
     BONUS_CELLS pointe vers 10 cases DÉJÀ présentes dans WORDS
     ci-dessus (donc pas de mot séparé à placer). Chaque cellule doit
     porter, à sa position, la lettre correspondante de BONUS_WORD —
     c'est vérifié automatiquement au chargement (voir console si erreur).
  ------------------------------------------------------------ */
  var BONUS_WORD = "ECHANGEONS";
  var BONUS_CELLS = [
    { row: 0,  col: 6  }, // E — ECLIPSE
    { row: 3,  col: 4  }, // C — CANICULE
    { row: 3,  col: 8  }, // H — ACHATS
    { row: 2,  col: 10 }, // A — ADAPTATION
    { row: 4,  col: 0  }, // N — OMNIBUS
    { row: 5,  col: 2  }, // G — GOUVERNANCE
    { row: 7,  col: 7  }, // E — RESILIENCE
    { row: 2,  col: 0  }, // O — OMNIBUS
    { row: 11, col: 10 }, // N — ADAPTATION
    { row: 6,  col: 8  }  // S — ACHATS
  ];

  var gridEl = document.getElementById("grid");
  var cluesHEl = document.getElementById("clues-h");
  var cluesVEl = document.getElementById("clues-v");
  var revealBtn = document.getElementById("reveal-btn");
  var bonusBanner = document.getElementById("bonus-banner");
  var bonusCta = document.getElementById("bonus-cta");
  var mysteryBoxesEl = document.getElementById("mystery-boxes");

  bonusCta.setAttribute("href", RDV_URL);

  /* ---------- Build the cell model from WORDS ---------- */
  var cells = {};
  var minR = Infinity, maxR = -Infinity, minC = Infinity, maxC = -Infinity;

  WORDS.forEach(function (w, wi) {
    w.cellsKeys = [];
    for (var i = 0; i < w.answer.length; i++) {
      var r = w.row + (w.dir === "V" ? i : 0);
      var c = w.col + (w.dir === "H" ? i : 0);
      var key = r + "," + c;
      if (!cells[key]) cells[key] = { r: r, c: c, letter: w.answer[i], wordIndices: [] };
      cells[key].wordIndices.push(wi);
      w.cellsKeys.push(key);
      minR = Math.min(minR, r); maxR = Math.max(maxR, r);
      minC = Math.min(minC, c); maxC = Math.max(maxC, c);
    }
  });

  /* ---------- Wire up bonus cells + integrity check ---------- */
  var bonusKeyForCell = {}; // "r,c" -> bonus index (0-based)
  BONUS_CELLS.forEach(function (pos, idx) {
    var key = pos.row + "," + pos.col;
    var cellData = cells[key];
    var expected = BONUS_WORD[idx];
    if (!cellData) {
      console.error("Mot mystère : la case", key, "n'existe dans aucun mot de la grille.");
      return;
    }
    if (cellData.letter !== expected) {
      console.error("Mot mystère : incohérence à", key, "— attendu", expected, "trouvé", cellData.letter);
    }
    bonusKeyForCell[key] = idx;
  });

  /* ---------- Numbering (classic crossword convention) ---------- */
  var startKeyList = [];
  WORDS.forEach(function (w) {
    var key = w.row + "," + w.col;
    if (startKeyList.indexOf(key) === -1) startKeyList.push(key);
  });
  startKeyList.sort(function (a, b) {
    var pa = a.split(",").map(Number), pb = b.split(",").map(Number);
    return pa[0] - pb[0] || pa[1] - pb[1];
  });
  var numberByKey = {};
  startKeyList.forEach(function (key, idx) { numberByKey[key] = idx + 1; });
  WORDS.forEach(function (w) { w.number = numberByKey[w.row + "," + w.col]; });

  /* ---------- Render grid ---------- */
  var rows = maxR - minR + 1;
  var cols = maxC - minC + 1;
  gridEl.style.gridTemplateColumns = "repeat(" + cols + ", 1fr)";
  gridEl.style.gridTemplateRows = "repeat(" + rows + ", 1fr)";

  for (var r = minR; r <= maxR; r++) {
    for (var c = minC; c <= maxC; c++) {
      var key = r + "," + c;
      var cellData = cells[key];
      if (!cellData) {
        var blocked = document.createElement("div");
        blocked.className = "cell-blocked";
        blocked.setAttribute("aria-hidden", "true");
        gridEl.appendChild(blocked);
        continue;
      }
      var wrap = document.createElement("div");
      wrap.className = "cell-wrap";
      wrap.setAttribute("data-key", key);

      if (numberByKey[key]) {
        var numEl = document.createElement("span");
        numEl.className = "cell-number";
        numEl.textContent = numberByKey[key];
        wrap.appendChild(numEl);
      }

      if (bonusKeyForCell.hasOwnProperty(key)) {
        var badge = document.createElement("span");
        badge.className = "cell-bonus-badge";
        badge.textContent = bonusKeyForCell[key] + 1;
        badge.setAttribute("aria-hidden", "true");
        wrap.appendChild(badge);
      }

      var input = document.createElement("input");
      input.type = "text";
      input.maxLength = 1;
      input.autocomplete = "off";
      input.autocapitalize = "characters";
      input.spellcheck = false;
      input.inputMode = "text";
      input.setAttribute("aria-label", "Case ligne " + (r + 1) + ", colonne " + (c + 1));
      input.setAttribute("data-key", key);

      wrap.appendChild(input);
      gridEl.appendChild(wrap);

      cellData.el = wrap;
      cellData.inputEl = input;
    }
  }

  /* ---------- Render mystery boxes ---------- */
  BONUS_CELLS.forEach(function (pos, idx) {
    var box = document.createElement("div");
    box.className = "mystery-box";
    box.setAttribute("data-bonus-index", idx);
    var idxLabel = document.createElement("span");
    idxLabel.className = "idx";
    idxLabel.textContent = idx + 1;
    box.appendChild(idxLabel);
    var letterSpan = document.createElement("span");
    letterSpan.className = "letter";
    box.appendChild(letterSpan);
    mysteryBoxesEl.appendChild(box);
  });

  function refreshMysteryStrip() {
    var allCorrect = true;
    BONUS_CELLS.forEach(function (pos, idx) {
      var key = pos.row + "," + pos.col;
      var cellData = cells[key];
      var value = cellData && cellData.inputEl ? cellData.inputEl.value.toUpperCase() : "";
      var box = mysteryBoxesEl.querySelector('.mystery-box[data-bonus-index="' + idx + '"]');
      var letterSpan = box.querySelector(".letter");
      letterSpan.textContent = value;
      var correct = value === BONUS_WORD[idx];
      box.classList.toggle("is-filled", !!value);
      if (!correct) allCorrect = false;
    });
    if (allCorrect) bonusBanner.classList.add("is-visible");
  }

  /* ---------- Render clue lists ---------- */
  function escapeHtml(s) {
    var div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }
  function wordLabel(w, wordIndex) {
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "clue-item";
    btn.setAttribute("data-word-index", wordIndex);
    btn.innerHTML =
      '<span class="num">' + w.number + '.</span>' +
      escapeHtml(w.clue) +
      ' <span class="count">(' + w.answer.length + ' lettres)</span>';
    return btn;
  }

  var wordsSortedForList = WORDS.slice().sort(function (a, b) { return a.number - b.number; });
  wordsSortedForList.forEach(function (w) {
    var wordIndex = WORDS.indexOf(w);
    var item = wordLabel(w, wordIndex);
    if (w.dir === "H") cluesHEl.appendChild(item);
    else cluesVEl.appendChild(item);
  });

  /* ---------- Interaction state ---------- */
  var activeDirection = "V";
  var activeWordIndex = null;

  function wordsAtCell(key) { return cells[key] ? cells[key].wordIndices : []; }

  function pickWordForCell(key, preferDir) {
    var idxs = wordsAtCell(key);
    if (idxs.length === 0) return null;
    var preferred = idxs.filter(function (wi) { return WORDS[wi].dir === preferDir; });
    return (preferred[0] !== undefined ? preferred[0] : idxs[0]);
  }

  function setActiveWord(wordIndex) {
    document.querySelectorAll(".cell-wrap.is-active-word").forEach(function (el) {
      el.classList.remove("is-active-word");
    });
    document.querySelectorAll(".clue-item.is-active").forEach(function (el) {
      el.classList.remove("is-active");
    });
    activeWordIndex = wordIndex;
    if (wordIndex === null) return;
    var w = WORDS[wordIndex];
    activeDirection = w.dir;
    w.cellsKeys.forEach(function (key) {
      if (cells[key] && cells[key].el) cells[key].el.classList.add("is-active-word");
    });
    var clueBtn = document.querySelector('.clue-item[data-word-index="' + wordIndex + '"]');
    if (clueBtn) clueBtn.classList.add("is-active");
  }

  function focusCell(key) {
    var cellData = cells[key];
    if (!cellData || !cellData.inputEl) return;
    cellData.inputEl.focus();
    // Select any existing character so the next keystroke replaces it —
    // without this, typing into an already-filled crossing cell (filled by
    // another word) is silently blocked by maxlength and auto-advance stalls.
    cellData.inputEl.select();
  }

  // handleCellFocus fires on EVERY focus change, including the ones we
  // trigger ourselves while auto-advancing through a word. It must never
  // switch away from the word currently being typed just because the new
  // cell also belongs to another word (that happens at every crossing).
  function handleCellFocus(key) {
    var idxs = wordsAtCell(key);
    if (idxs.length === 0) return;
    if (activeWordIndex !== null && idxs.indexOf(activeWordIndex) !== -1) {
      setActiveWord(activeWordIndex);
      return;
    }
    setActiveWord(pickWordForCell(key, activeDirection));
  }

  // Clicking a cell that is ALREADY the focused cell (a deliberate second
  // click on a crossing cell) toggles between its across/down word. Kept
  // separate from focus handling so typing never triggers an unwanted toggle.
  var lastClickedKey = null;
  gridEl.addEventListener("click", function (e) {
    var input = e.target.closest("input");
    if (!input) return;
    var key = input.getAttribute("data-key");
    var idxs = wordsAtCell(key);
    if (idxs.length > 1 && key === lastClickedKey && idxs.indexOf(activeWordIndex) !== -1) {
      var other = idxs.filter(function (wi) { return wi !== activeWordIndex; })[0];
      if (other !== undefined) setActiveWord(other);
    }
    lastClickedKey = key;
  });

  function nextCellInWord(wordIndex, fromKey, delta) {
    var w = WORDS[wordIndex];
    var idx = w.cellsKeys.indexOf(fromKey);
    var target = idx + delta;
    if (target < 0 || target >= w.cellsKeys.length) return null;
    return w.cellsKeys[target];
  }

  function checkWordComplete(wordIndex) {
    var w = WORDS[wordIndex];
    var value = w.cellsKeys.map(function (key) { return cells[key].inputEl.value.toUpperCase(); }).join("");
    return value === w.answer;
  }

  function refreshSolvedStates() {
    Object.keys(cells).forEach(function (key) { cells[key].el.classList.remove("is-solved"); });
    document.querySelectorAll(".clue-item.is-solved").forEach(function (el) { el.classList.remove("is-solved"); });

    WORDS.forEach(function (w, wi) {
      if (checkWordComplete(wi)) {
        w.cellsKeys.forEach(function (key) { cells[key].el.classList.add("is-solved"); });
        var clueBtn = document.querySelector('.clue-item[data-word-index="' + wi + '"]');
        if (clueBtn) clueBtn.classList.add("is-solved");
      }
    });

    refreshMysteryStrip();
  }

  function normalizeChar(raw) {
    if (!raw) return "";
    var stripped = raw.normalize ? raw.normalize("NFD").replace(/[\u0300-\u036f]/g, "") : raw;
    var upper = stripped.toUpperCase().replace(/[^A-Z]/g, "");
    return upper.slice(-1);
  }

  gridEl.addEventListener("focusin", function (e) {
    if (e.target.tagName !== "INPUT") return;
    handleCellFocus(e.target.getAttribute("data-key"));
  });

  gridEl.addEventListener("input", function (e) {
    var input = e.target;
    if (input.tagName !== "INPUT") return;
    var key = input.getAttribute("data-key");
    var value = normalizeChar(input.value);
    input.value = value;
    cells[key].el.classList.remove("is-revealed");

    if (value && activeWordIndex !== null) {
      var next = nextCellInWord(activeWordIndex, key, 1);
      if (next) focusCell(next);
    }
    refreshSolvedStates();
  });

  gridEl.addEventListener("keydown", function (e) {
    var input = e.target;
    if (input.tagName !== "INPUT") return;
    var key = input.getAttribute("data-key");
    var cellData = cells[key];

    if (e.key === "Backspace" && !input.value && activeWordIndex !== null) {
      var prev = nextCellInWord(activeWordIndex, key, -1);
      if (prev) {
        focusCell(prev);
        cells[prev].inputEl.value = "";
        refreshSolvedStates();
      }
      return;
    }

    var r = cellData.r, c = cellData.c;
    var targetKey = null;
    if (e.key === "ArrowRight") { targetKey = (r) + "," + (c + 1); activeDirection = "H"; }
    else if (e.key === "ArrowLeft") { targetKey = (r) + "," + (c - 1); activeDirection = "H"; }
    else if (e.key === "ArrowDown") { targetKey = (r + 1) + "," + (c); activeDirection = "V"; }
    else if (e.key === "ArrowUp") { targetKey = (r - 1) + "," + (c); activeDirection = "V"; }

    if (targetKey && cells[targetKey]) {
      e.preventDefault();
      focusCell(targetKey);
      setActiveWord(pickWordForCell(targetKey, activeDirection));
    }
  });

  cluesHEl.addEventListener("click", handleClueClick);
  cluesVEl.addEventListener("click", handleClueClick);
  function handleClueClick(e) {
    var btn = e.target.closest(".clue-item");
    if (!btn) return;
    var wordIndex = parseInt(btn.getAttribute("data-word-index"), 10);
    setActiveWord(wordIndex);
    focusCell(WORDS[wordIndex].cellsKeys[0]);
  }

  revealBtn.addEventListener("click", function () {
    WORDS.forEach(function (w) {
      w.cellsKeys.forEach(function (key, i) {
        var cellData = cells[key];
        var correct = w.answer[i];
        if (cellData.inputEl.value.toUpperCase() !== correct) {
          cellData.inputEl.value = correct;
          cellData.el.classList.add("is-revealed");
        }
      });
    });
    refreshSolvedStates();
  });

  refreshMysteryStrip();
})();
</script>

</body>
</html>
