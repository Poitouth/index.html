  }
  #bonus-banner strong{ color: var(--gold); }
  #bonus-banner a{
    display: inline-block;
    background: var(--gold);
    color: var(--forest-deep);
    font-weight: 700;
    text-decoration: none;
    padding: .75rem 1.5rem;
    border-radius: 999px;
  }
  #bonus-banner a:hover{ background: #e6b41c; }

  /* ---------- Footer ---------- */
  footer{
    text-align: center;
    padding: 1.5rem 1.25rem 2.5rem;
    color: var(--ink-soft);
    font-size: .85rem;
    border-top: 1px solid var(--line);
  }
  footer a{ color: var(--ink-soft); text-decoration: none; font-weight: 600; }
  footer a:hover{ color: var(--forest); }

  @media (prefers-reduced-motion: reduce){
    .cell-wrap input{ transition: none; }
  }
</style>
